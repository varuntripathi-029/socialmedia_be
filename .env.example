# ============================================
# Social Media Backend - Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.

# Server
PORT=8080

# PostgreSQL Database
DB_URL=jdbc:postgresql://localhost:5432/socialmedia
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_min_32_chars

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# File Uploads
FILE_UPLOAD_DIR=uploads

# Google OAuth2
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# (Optional) Spring Profile — set to 'prod' for production
SPRING_PROFILES_ACTIVE=prod

# Local-only docker-compose Postgres container (separate from DB_* above —
# never reuse your real database password here)
LOCAL_POSTGRES_DB=neondb
LOCAL_POSTGRES_USER=neondb_owner
LOCAL_POSTGRES_PASSWORD=change_me_local_only

# Cloudinary (persistent image storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
